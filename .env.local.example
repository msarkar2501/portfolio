# Copy this file to ".env.local" and fill in your own values.
# .env.local is git-ignored so your secrets never get committed.

# The password you type at /admin to unlock editing.
ADMIN_PASSWORD=change-me-to-something-private

# A long random string used to sign your editing session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-a-long-random-hex-string
